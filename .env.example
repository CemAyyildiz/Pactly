# Copy to .env at the repository root: cp .env.example .env
# The backend reads these once in backend/src/config.ts and refuses to start
# if a variable is missing. Never commit .env.

# Port the backend HTTP server listens on.
BACKEND_PORT=3001

# Stellar network. Testnet only for now.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Anchor home domain. SEP endpoints are discovered from its stellar.toml (AD-10).
ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# The domain Pactly's own SEP-10-shaped login (AD-5) issues its challenge
# under -- never the anchor's domain above. A real deployment sets this to
# the domain the frontend is served from.
PACTLY_HOME_DOMAIN=pactly.example

# Secret Pactly's own login signs its JWT with, and (domain-separated)
# derives the server keypair its own challenge is issued and verified
# under. Must be at least 32 characters (backend/src/config.ts refuses a
# shorter one); the value below is a random placeholder good enough to boot
# a local dev instance -- generate your own (e.g. `openssl rand -hex 24`)
# and rotate it before this ever runs anywhere beyond local dev. Never
# share this; rotating it invalidates every issued session.
PACTLY_AUTH_SIGNING_SECRET=35367fefd6cde84700466ba9eb20f6c95f853394760ffa69

# Escrow contract id (C...). Must be present; may stay empty until
# `npm run setup:testnet` deploys the contract and prints this for you to
# paste in.
ESCROW_CONTRACT_ID=

# Comma-separated Stellar account ids (G...) with the admin role (AD-12).
# `npm run setup:testnet` prints its demo admin account's public key for you
# to paste in here (added to, not replacing, any wallets already listed).
# Must be present; may be empty.
PACTLY_ADMIN_WALLETS=

# Trustless Work escrow adapter (Story 2.6, AD-8). The installed
# @trustless-work/escrow-js@1.0.0-beta.1 package's own `development`/
# `mainNet` constant currently points at https://beta.api.trustlesswork.com
# -- not the dev.api.trustlesswork.com this story's own spec assumed before
# the real package was installed and read; see Story 2.6's final report.
# May stay empty until Story 1.8's blocked live ACs are unblocked with a
# real operator key -- the adapter refuses before any network access when
# this is empty, same discipline as ESCROW_CONTRACT_ID above.
TRUSTLESS_WORK_API_URL=
# x-api-key header value for the Trustless Work API. Empty until a real
# operator key exists.
TRUSTLESS_WORK_API_KEY=
# Attribution header value (X-TW-Platform) identifying Pactly to Trustless
# Work; provided by the operator's TW account, not invented here. May be
# empty.
TRUSTLESS_WORK_PLATFORM_ID=
# Pactly's own Stellar account (G...) used for every Trustless Work role
# Pactly itself holds: platform, dispute resolver, and (Story 2.6's own
# admin-role decision) admin. Signing itself is out of this story's scope
# -- only the address is needed to build unsigned XDR naming Pactly
# correctly. May be empty.
TRUSTLESS_WORK_PLATFORM_ADDRESS=

# Testnet demo accounts `npm run setup:testnet` funds and prints (secret
# keys, S...). Not read by the backend; keep them here so a re-run reuses
# the same accounts instead of generating new ones. Empty until that command
# is run.
PACTLY_DEMO_ADMIN_SECRET=
PACTLY_DEMO_PROFESSIONAL_SECRET=
PACTLY_DEMO_CLIENT_SECRET=

# SQLite database file. A relative path resolves against backend/,
# whichever directory the backend is started from.
DATABASE_PATH=./data/pactly.db
