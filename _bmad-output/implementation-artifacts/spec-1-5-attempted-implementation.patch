+
+/// A deposit has left the contract for the client.
+///
+/// Emitted by `resolve_cancel` when the booking was resolved on or before its
+/// `cancel_deadline`, and only after the transfer out of the contract address
+/// succeeded — so the event's existence means the money really moved. A
+/// `resolve_cancel` after the deadline pays the professional and emits
+/// [`Released`] instead: what the event worker needs to know is where the
+/// deposit went, not which function moved it.
+///
+/// Its wire shape is [`Locked`]'s and [`Released`]'s, so the event worker
+/// handles all three symmetrically.
+///
+/// Topics: `("refunded", booking_id)`. Data: `amount`.
+#[contractevent(topics = ["refunded"], data_format = "single-value")]
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Refunded {
+    /// The booking whose deposit was returned.
+    #[topic]
+    pub booking_id: BookingId,
+    /// Amount returned to the client, in the token's smallest unit.
+    pub amount: i128,
+}
