-//! path it leaves for the professional. `resolve_cancel` arrives in Story 1.5
-//! and extends the same `#[contractimpl]` block.
+//! path it leaves for the professional. Story 1.5 adds `resolve_cancel` to the
+//! same `#[contractimpl]` block: the permissionless path that settles a booking
+//! nobody signed off, by comparing the ledger clock with the cancel deadline.
 
 pub mod error;
 pub mod events;
@@ -207,6 +208,82 @@ impl EscrowContract {
 
         Ok(())
     }
+
+    /// Settle a booking that did not happen, by the clock alone.
+    ///
+    /// Takes **no authorization from anybody**. That is the point of it, not a
+    /// relaxation of [`Self::release`]: `release` demands the client's signature
+    /// because it moves money the client paid, whereas a client who never shows
+    /// up will never sign anything, and without this path the professional's
+    /// deposit would be stranded forever. A stranger calling it gains nothing —
+    /// the outcome was already fixed by the deadline, and the money can only
+    /// reach one of the two addresses on the record.
+    ///
+    /// `env.ledger().timestamp()` decides which way it goes, both values being
+    /// UTC epoch seconds with no tolerance window:
+    /// - `now <= cancel_deadline` — an on-time cancellation. The full stored
+    ///   `amount` goes back to the client, the record becomes
+    ///   [`BookingState::Refunded`] and a `refunded` event is emitted. The
+    ///   boundary second belongs to the client: the deadline is published to
+    ///   them as the end of their free-cancellation window, so the window
+    ///   includes it.
+    /// - `now > cancel_deadline` — a no-show. The full stored `amount` goes to
+    ///   the professional, the record becomes [`BookingState::Released`] and the
+    ///   same `released` event `release` emits is emitted, because the
+    ///   destination is what the backend needs to know, not which function moved
+    ///   the money.
+    ///
+    /// No partial refund, no fee, no penalty split: whoever the deadline picks
+    /// receives the whole amount.
+    ///
+    /// [`Error::BookingNotFound`] for an unknown id, and [`Error::InvalidState`]
+    /// for a booking that has already been released or refunded — so the deposit
+    /// moves exactly once, on either side of the deadline.
+    pub fn resolve_cancel(env: Env, booking_id: BookingId) -> Result<(), Error> {
+        let mut booking = storage::get_booking(&env, &booking_id)?;
+
+        // State before the clock: reading the timestamp for a booking that is
+        // already terminal is work with no bearing on the answer, and the guard
+        // order stays readable — existence, then legality, then outcome.
+        if booking.state != BookingState::Locked {
+            return Err(Error::InvalidState);
+        }
+
+        let on_time = env.ledger().timestamp() <= booking.cancel_deadline;
+        let recipient = if on_time {
+            &booking.client
+        } else {
+            &booking.professional
+        };
+
+        // Same shape as `create_booking` and `release`: transfer, then write,
+        // then emit. The whole invocation is atomic either way — a token that
+        // traps rolls back every write — so the ordering is the house pattern
+        // rather than the thing that makes it safe.
+        TokenClient::new(&env, &booking.token).transfer(
+            &env.current_contract_address(),
+            recipient,
+            &booking.amount,
+        );
+
+        booking.state = if on_time {
+            BookingState::Refunded
+        } else {
+            BookingState::Released
+        };
+        let amount = booking.amount;
+        storage::set_booking(&env, &booking_id, &booking);
+
+        // Emitted last, for the same reason as `locked` and `released`: the
+        // event must not exist unless the money really moved.
+        if on_time {
+            events::Refunded { booking_id, amount }.publish(&env);
+        } else {
+            events::Released { booking_id, amount }.publish(&env);
+        }
+
+        Ok(())
+    }
 }
 
