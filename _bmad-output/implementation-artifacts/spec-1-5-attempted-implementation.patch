+
+// ---------------------------------------------------------------------------
+// Story 1.5 — resolve_cancel
+// ---------------------------------------------------------------------------
+
+/// The stored record, asserted field by field against the fixture's inputs with
+/// only `state` allowed to have moved.
+fn assert_only_the_state_moved(f: &Fixture, state: BookingState) {
+    f.env.as_contract(&f.contract_id, || {
+        assert_eq!(
+            storage::get_booking(&f.env, &f.booking_id).unwrap(),
+            Booking {
+                professional: f.professional.clone(),
+                client: f.client.clone(),
+                token: f.token.clone(),
+                amount: f.amount,
+                cancel_deadline: f.cancel_deadline,
+                state,
+            }
+        );
+    });
+}
+
+// Matrix row: on-time cancellation.
+#[test]
+fn resolving_before_the_deadline_refunds_the_client() {
+    let f = locked_fixture();
+    f.env.ledger().set_timestamp(f.cancel_deadline - 1);
+
+    assert_eq!(f.resolve_cancel(), Ok(Ok(())));
+
+    // The `refunded` event carries the booking id in its topics and the amount
+    // as data — `locked`'s and `released`'s shape exactly. Checked first:
+    // `events().all()` only covers the last invocation, and reading a balance is
+    // one.
+    assert_eq!(f.own_events(), f.expected_refunded_event());
+
+    // The client's balance is whole again and the escrow holds nothing for this
+    // booking: no fee, no cut, no partial refund.
+    let token = f.token_client();
+    assert_eq!(token.balance(&f.client), FUNDING);
+    assert_eq!(
+        token.balance(&f.contract_id),
+        0,
+        "the escrow still holds the deposit"
+    );
+    assert_eq!(
+        token.balance(&f.professional),
+        0,
+        "the professional was paid on an on-time cancellation"
+    );
+
+    assert_only_the_state_moved(&f, BookingState::Refunded);
+}
+
+// Matrix row: cancelled exactly on the deadline. The boundary second belongs to
+// the client — the deadline is published to them as the end of their free
+// cancellation window, so the window has to include it.
+#[test]
+fn resolving_exactly_on_the_deadline_refunds_the_client() {
+    let f = locked_fixture();
+    f.env.ledger().set_timestamp(f.cancel_deadline);
+
+    assert_eq!(f.resolve_cancel(), Ok(Ok(())));
+
+    assert_eq!(f.own_events(), f.expected_refunded_event());
+    let token = f.token_client();
+    assert_eq!(token.balance(&f.client), FUNDING);
+    assert_eq!(token.balance(&f.professional), 0);
+    assert_eq!(token.balance(&f.contract_id), 0);
+
+    assert_only_the_state_moved(&f, BookingState::Refunded);
+}
+
+// Matrix row: no-show. One second past the deadline the deposit belongs to the
+// professional, and the outcome reuses `released` — what the event worker needs
+// to know is where the deposit went, not which function moved it.
+#[test]
+fn resolving_after_the_deadline_pays_the_professional() {
+    let f = locked_fixture();
+    f.env.ledger().set_timestamp(f.cancel_deadline + 1);
+
+    assert_eq!(f.resolve_cancel(), Ok(Ok(())));
+
+    assert_eq!(f.own_events(), f.expected_released_event());
+    let token = f.token_client();
+    assert_eq!(token.balance(&f.professional), f.amount);
+    assert_eq!(
+        token.balance(&f.contract_id),
+        0,
+        "the escrow still holds the deposit"
+    );
+    assert_eq!(
+        token.balance(&f.client),
+        FUNDING - f.amount,
+        "the client was refunded after the deadline"
+    );
+
+    assert_only_the_state_moved(&f, BookingState::Released);
+}
+
+// Matrix row: called by a stranger. `resolve_cancel` carries no `require_auth`
+// at all — that is the feature: a client who never shows up will never sign
+// anything, so the professional's deposit would otherwise be stranded forever.
+#[test]
+fn resolve_cancel_needs_no_authorization_from_anybody() {
+    // Before the deadline: still a refund, with no signature anywhere.
+    let f = locked_fixture();
+    // Switch from `mock_all_auths` to enforcing auth with no signatures supplied.
+    f.env.set_auths(&[]);
+
+    assert_eq!(
+        f.resolve_cancel(),
+        Ok(Ok(())),
+        "expected success, not a host auth error"
+    );
+    assert_eq!(f.own_events(), f.expected_refunded_event());
+    assert_eq!(f.token_client().balance(&f.client), FUNDING);
+
+    // After the deadline: still a payout, with no signature anywhere. The
+    // caller's identity changes nothing either way — the clock already decided.
+    let g = locked_fixture();
+    g.env.ledger().set_timestamp(g.cancel_deadline + 1);
+    g.env.set_auths(&[]);
+
+    assert_eq!(
+        g.resolve_cancel(),
+        Ok(Ok(())),
+        "expected success, not a host auth error"
+    );
+    assert_eq!(g.own_events(), g.expected_released_event());
+    assert_eq!(g.token_client().balance(&g.professional), g.amount);
+}
+
+// The resolve write must bump the TTL too, or a settled record could be archived
+// while the backend still needs to read the outcome.
+#[test]
+fn resolving_a_cancellation_bumps_the_bookings_ttl() {
+    let f = locked_fixture();
+
+    // Advance past the bump threshold first: straight after `create_booking` the
+    // TTL is already at its ceiling, so a resolve that never bumped would still
+    // look correct.
+    let sequence = f.env.ledger().sequence();
+    f.env
+        .ledger()
+        .set_sequence_number(sequence + 2 * (BUMP_LEDGERS - BUMP_THRESHOLD_LEDGERS));
+
+    let key = DataKey::Booking(f.booking_id.clone());
+    f.env.as_contract(&f.contract_id, || {
+        assert!(
+            f.env.storage().persistent().get_ttl(&key) < BUMP_THRESHOLD_LEDGERS,
+            "the entry was not yet due for a bump, so this test proves nothing"
+        );
+    });
+
+    f.resolve_cancel().unwrap().unwrap();
+
+    f.env.as_contract(&f.contract_id, || {
+        assert_eq!(f.env.storage().persistent().get_ttl(&key), BUMP_LEDGERS);
+    });
+}
+
+// Matrix row: unknown booking id.
+#[test]
+fn resolving_an_unknown_booking_id_is_rejected_and_changes_nothing() {
+    let f = locked_fixture();
+    let before = f.snapshot();
+
+    let unknown_id = BytesN::from_array(&f.env, &[0x77; 16]);
+
+    assert_eq!(
+        f.client_contract.try_resolve_cancel(&unknown_id),
+        Err(Ok(Error::BookingNotFound))
+    );
+
+    assert_release_changed_nothing(&f, &before);
+    // The snapshot only watches the fixture's own id, so the id that was asked
+    // for needs its own check: a rejected call must not have created it either.
+    f.env.as_contract(&f.contract_id, || {
+        assert!(
+            !storage::has_booking(&f.env, &unknown_id),
+            "a rejected resolve wrote a booking under the unknown id"
+        );
+    });
+}
+
+// Matrix row: already released. `release` and `resolve_cancel` act on the same
+// Locked record and the terminal-state check is the only arbiter — whichever
+// lands first wins, and the second gets InvalidState.
+#[test]
+fn resolving_an_already_released_booking_is_rejected_and_changes_nothing() {
+    let f = locked_fixture();
+    f.release().unwrap().unwrap();
+
+    let before = f.snapshot();
+
+    assert_eq!(f.resolve_cancel(), Err(Ok(Error::InvalidState)));
+
+    assert_release_changed_nothing(&f, &before);
+    assert_eq!(
+        before.booking.as_ref().map(|b| b.state),
+        Some(BookingState::Released),
+        "the record should still read Released"
+    );
+}
+
+// Matrix row: already refunded, and matrix row: resolved twice in a row before
+// the deadline. The state check is what stands between a repeated call and a
+// second refund.
+#[test]
+fn resolving_a_refunded_booking_twice_refunds_the_client_exactly_once() {
+    let f = locked_fixture();
+    f.resolve_cancel().unwrap().unwrap();
+
+    let before = f.snapshot();
+
+    assert_eq!(f.resolve_cancel(), Err(Ok(Error::InvalidState)));
+
+    assert_release_changed_nothing(&f, &before);
+    assert_eq!(
+        before.booking.as_ref().map(|b| b.state),
+        Some(BookingState::Refunded),
+        "the record should still read Refunded"
+    );
+    let token = f.token_client();
+    assert_eq!(
+        token.balance(&f.client),
+        FUNDING,
+        "the client was refunded more than once"
+    );
+    assert_eq!(token.balance(&f.contract_id), 0);
+    assert_eq!(token.balance(&f.professional), 0);
+}
+
+// Matrix row: resolved twice in a row, after the deadline. The money moves
+// exactly once on this side of it too.
+#[test]
+fn resolving_twice_after_the_deadline_pays_the_professional_exactly_once() {
+    let f = locked_fixture();
+    f.env.ledger().set_timestamp(f.cancel_deadline + 1);
+
+    assert_eq!(f.resolve_cancel(), Ok(Ok(())));
+    assert_eq!(f.resolve_cancel(), Err(Ok(Error::InvalidState)));
+
+    assert!(
+        f.own_events().events().is_empty(),
+        "the second resolve emitted an event"
+    );
+
+    let token = f.token_client();
+    assert_eq!(
+        token.balance(&f.professional),
+        f.amount,
+        "the professional was paid more than once"
+    );
+    assert_eq!(token.balance(&f.contract_id), 0);
+    assert_eq!(token.balance(&f.client), FUNDING - f.amount);
+}
+
+// A resolved refund is terminal for `release` as well, so a client cannot get
+// their deposit back and then pay it out again.
+#[test]
+fn releasing_a_resolve_refunded_booking_is_rejected_and_changes_nothing() {
+    let f = locked_fixture();
+    f.resolve_cancel().unwrap().unwrap();
+
+    let before = f.snapshot();
+
+    assert_eq!(f.release(), Err(Ok(Error::InvalidState)));
+
+    assert_release_changed_nothing(&f, &before);
+}
+
+// Bookings settle one at a time: resolving one returns its own deposit and
+// leaves every other one in the contract's custody.
+#[test]
+fn resolving_one_booking_leaves_another_untouched() {
+    let f = locked_fixture();
+
+    let second_id = BytesN::from_array(&f.env, &[0x2e; 16]);
+    let second_amount = 75_000_000_i128;
+    let second_professional = Address::generate(&f.env);
+    f.client_contract.create_booking(
+        &second_id,
+        &second_professional,
+        &f.client,
+        &f.token,
+        &second_amount,
+        &(f.cancel_deadline + 3_600),
+    );
+
+    assert_eq!(f.resolve_cancel(), Ok(Ok(())));
+
+    let token = f.token_client();
+    assert_eq!(token.balance(&f.client), FUNDING - second_amount);
+    assert_eq!(
+        token.balance(&f.contract_id),
+        second_amount,
+        "the other booking's deposit left the escrow"
+    );
+
+    f.env.as_contract(&f.contract_id, || {
+        assert_eq!(
+            storage::get_booking(&f.env, &second_id).unwrap().state,
+            BookingState::Locked
+        );
+    });
+}
