index 0000000..b6b63af
--- /dev/null
+++ b/backend/test/escrow-trustless-work-reconciler.test.ts
@@ -0,0 +1,297 @@
+/**
+ * The Trustless Work reconciler driven as a unit, over a real temporary
+ * SQLite database (`openDatabase(":memory:")`) through its injected
+ * `FetchEscrowEvidence` seam -- never against the network. Covers the I/O
+ * matrix rows this story's spec names for the reconciler: event batch
+ * mirrored (every recognized lifecycle action), same batch replayed
+ * (dedupe by `(transactionHash, lifecycleAction)`), restart resumes from
+ * the stored cursor, and evidence for an unknown booking recorded as an
+ * anomaly with the reconciler continuing -- each at the *batch* level
+ * (`runReconcilerOnce`), not only the single-item level, per Story 2.5's
+ * own review finding that batch-level cursor/restart coverage was missing.
+ */
+import "./testConfigEnv.js";
+import { randomUUID } from "node:crypto";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import type { EscrowEvent } from "@trustless-work/escrow-js";
+
+import {
+  decodeEscrowEvidence,
+  escrowStateForLifecycleAction,
+  processEscrowEvidence,
+  runReconcilerOnce,
+  type EscrowEvidence,
+  type FetchEscrowEvidence,
+} from "../src/escrow/trustless-work/reconciler.js";
+import { getBookingById } from "../src/db/bookings.js";
+import { getEscrowReconcilerCursor } from "../src/db/escrowReconcilerCursor.js";
+import { getEscrowProcessedEvent } from "../src/db/escrowProcessedEvents.js";
+import { closeDatabase, openTestDatabase, randomBookingId, seedBooking } from "./helpers.js";
+
+function fakeEvidence(overrides: Partial<EscrowEvidence> & Pick<EscrowEvidence, "bookingId" | "lifecycleAction">): EscrowEvidence {
+  return {
+    transactionHash: randomUUID(),
+    amount: "1000000",
+    contractId: `C${randomUUID().replace(/-/g, "").toUpperCase().slice(0, 55)}`,
+    ledgerSeq: "100",
+    ...overrides,
+  };
+}
+
+test("funded evidence for a known booking sets escrow_state to locked", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    const outcome = await processEscrowEvidence(result.db, fakeEvidence({ bookingId, lifecycleAction: "funded" }));
+    assert.equal(outcome, "applied");
+    const booking = await getBookingById(result.db, bookingId);
+    assert.equal(booking?.escrowState, "locked");
+    assert.equal(booking?.balanceState, "unpaid");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("approved evidence stays locked and is recorded as a distinct row from funded", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    await processEscrowEvidence(result.db, fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-funded" }));
+    const outcome = await processEscrowEvidence(
+      result.db,
+      fakeEvidence({ bookingId, lifecycleAction: "approved", transactionHash: "tx-approved" }),
+    );
+    assert.equal(outcome, "applied");
+    const booking = await getBookingById(result.db, bookingId);
+    assert.equal(booking?.escrowState, "locked");
+
+    const fundedRow = await getEscrowProcessedEvent(result.db, "tx-funded", "funded");
+    const approvedRow = await getEscrowProcessedEvent(result.db, "tx-approved", "approved");
+    assert.ok(fundedRow);
+    assert.ok(approvedRow);
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("released evidence sets escrow_state to released", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    const outcome = await processEscrowEvidence(result.db, fakeEvidence({ bookingId, lifecycleAction: "released" }));
+    assert.equal(outcome, "applied");
+    const booking = await getBookingById(result.db, bookingId);
+    assert.equal(booking?.escrowState, "released");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("disputed evidence leaves escrow_state locked -- opening a dispute never moves money automatically", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    await processEscrowEvidence(result.db, fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-funded" }));
+    const outcome = await processEscrowEvidence(
+      result.db,
+      fakeEvidence({ bookingId, lifecycleAction: "disputed", transactionHash: "tx-disputed" }),
+    );
+    assert.equal(outcome, "applied");
+    const booking = await getBookingById(result.db, bookingId);
+    assert.equal(booking?.escrowState, "locked", "a dispute being opened must never look like a resolution");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("replaying the same (transactionHash, lifecycleAction) changes nothing and inserts no duplicate row", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    const evidence = fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-1", contractId: "C-FIRST" });
+
+    const first = await processEscrowEvidence(result.db, evidence);
+    assert.equal(first, "applied");
+
+    // A replay carries a different contractId/ledgerSeq (redelivered with
+    // slightly different read-model metadata), but the same
+    // (transactionHash, lifecycleAction) -- that pair is the dedupe key.
+    const second = await processEscrowEvidence(result.db, { ...evidence, contractId: "C-SECOND", ledgerSeq: "200" });
+    assert.equal(second, "duplicate");
+
+    const booking = await getBookingById(result.db, bookingId);
+    assert.equal(booking?.escrowState, "locked");
+
+    const row = await getEscrowProcessedEvent(result.db, "tx-1", "funded");
+    assert.ok(row);
+    assert.equal(row.contractId, "C-FIRST", "the first evidence's own metadata must win, not the replay's");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("evidence for an unknown booking id invents no row, is recorded as an anomaly, and the reconciler continues", async () => {
+  const result = openTestDatabase();
+  try {
+    const unknownBookingId = randomBookingId();
+    const knownBooking = await seedBooking(result);
+
+    const fetchEscrowEvidence: FetchEscrowEvidence = async () => ({
+      evidence: [
+        fakeEvidence({ bookingId: unknownBookingId, lifecycleAction: "funded", transactionHash: "tx-unknown" }),
+        fakeEvidence({ bookingId: knownBooking, lifecycleAction: "funded", transactionHash: "tx-known" }),
+      ],
+      cursor: "cursor-after-batch",
+    });
+
+    const messages: string[] = [];
+    const batchResult = await runReconcilerOnce({
+      db: result.db,
+      fetchEscrowEvidence,
+      log: (message) => messages.push(message),
+    });
+
+    assert.equal(batchResult.anomalies, 1);
+    assert.equal(batchResult.applied, 1);
+    assert.equal(await getBookingById(result.db, unknownBookingId), undefined, "no row should be invented");
+    assert.equal((await getBookingById(result.db, knownBooking))?.escrowState, "locked");
+
+    const anomalyRow = await getEscrowProcessedEvent(result.db, "tx-unknown", "funded");
+    assert.equal(anomalyRow?.isAnomaly, true);
+    assert.ok(messages.some((message) => message.includes("anomaly")));
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("a restarted reconciler resumes from the stored cursor, not from the start (batch level)", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+
+    const firstFetch: FetchEscrowEvidence = async (cursor) => {
+      assert.equal(cursor, undefined, "first run should fetch from the beginning");
+      return {
+        evidence: [fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-1" })],
+        cursor: "cursor-after-first-batch",
+      };
+    };
+    const firstResult = await runReconcilerOnce({ db: result.db, fetchEscrowEvidence: firstFetch });
+    assert.equal(firstResult.applied, 1);
+    assert.equal(firstResult.cursor, "cursor-after-first-batch");
+    assert.equal(await getEscrowReconcilerCursor(result.db), "cursor-after-first-batch");
+
+    let secondFetchCalledWith: string | undefined;
+    const secondFetch: FetchEscrowEvidence = async (cursor) => {
+      secondFetchCalledWith = cursor;
+      return { evidence: [], cursor: "cursor-after-second-batch" };
+    };
+    await runReconcilerOnce({ db: result.db, fetchEscrowEvidence: secondFetch });
+    assert.equal(secondFetchCalledWith, "cursor-after-first-batch", "restart must resume from the stored cursor");
+    assert.equal(await getEscrowReconcilerCursor(result.db), "cursor-after-second-batch");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("replaying an entire batch changes nothing observable and still advances the cursor", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    const batch = [
+      fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-1" }),
+      fakeEvidence({ bookingId, lifecycleAction: "approved", transactionHash: "tx-2" }),
+    ];
+
+    const firstFetch: FetchEscrowEvidence = async () => ({ evidence: batch, cursor: "cursor-1" });
+    const firstResult = await runReconcilerOnce({ db: result.db, fetchEscrowEvidence: firstFetch });
+    assert.equal(firstResult.applied, 2);
+    assert.equal(firstResult.duplicates, 0);
+
+    const bookingAfterFirst = await getBookingById(result.db, bookingId);
+
+    // The exact same batch, redelivered (e.g. the indexer re-sends a page
+    // it already served) -- same transactionHash/lifecycleAction pairs,
+    // under a fresh cursor value.
+    const secondFetch: FetchEscrowEvidence = async () => ({ evidence: batch, cursor: "cursor-2" });
+    const secondResult = await runReconcilerOnce({ db: result.db, fetchEscrowEvidence: secondFetch });
+
+    assert.equal(secondResult.applied, 0);
+    assert.equal(secondResult.duplicates, 2);
+    assert.equal(secondResult.cursor, "cursor-2", "the cursor must still advance even though nothing new was applied");
+    assert.equal(await getEscrowReconcilerCursor(result.db), "cursor-2");
+
+    const bookingAfterSecond = await getBookingById(result.db, bookingId);
+    assert.deepEqual(bookingAfterSecond, bookingAfterFirst, "a replayed batch must change nothing observable");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("a failure between the dedupe insert and the escrow-state write leaves nothing committed, so the evidence is still re-processable", async () => {
+  const result = openTestDatabase();
+  try {
+    const bookingId = await seedBooking(result);
+    const evidence = fakeEvidence({ bookingId, lifecycleAction: "funded", transactionHash: "tx-1" });
+
+    await assert.rejects(() =>
+      processEscrowEvidence(result.db, evidence, undefined, {
+        updateEscrowState: () => {
+          throw new Error("simulated failure between the dedupe insert and the escrow-state write");
+        },
+      }),
+    );
+
+    assert.equal(await getEscrowProcessedEvent(result.db, "tx-1", "funded"), undefined);
+    assert.equal((await getBookingById(result.db, bookingId))?.escrowState, null);
+
+    const outcome = await processEscrowEvidence(result.db, evidence);
+    assert.equal(outcome, "applied");
+    assert.equal((await getBookingById(result.db, bookingId))?.escrowState, "locked");
+  } finally {
+    closeDatabase(result);
+  }
+});
+
+test("escrowStateForLifecycleAction maps every recognized action to the right of the three escrow states", () => {
+  assert.equal(escrowStateForLifecycleAction("funded"), "locked");
+  assert.equal(escrowStateForLifecycleAction("approved"), "locked");
+  assert.equal(escrowStateForLifecycleAction("released"), "released");
+  assert.equal(escrowStateForLifecycleAction("disputed"), "locked");
+});
+
+function fakeRawEvent(overrides: Partial<EscrowEvent> = {}): EscrowEvent {
+  return {
+    kind: "funded",
+    actor: null,
+    ledgerSeq: "100",
+    txHash: "tx-1",
+    ledgerClosedAt: new Date().toISOString(),
+    topics: [],
+    payload: { amount: "1000000" },
+    ...overrides,
+  };
+}
+
+test("decodeEscrowEvidence decodes a recognized kind, reading the amount off the event's own payload", () => {
+  const decoded = decodeEscrowEvidence("booking-1", "contract-1", fakeRawEvent({ kind: "released", payload: { amount: "2500000" } }));
+  assert.deepEqual(decoded, {
+    bookingId: "booking-1",
+    transactionHash: "tx-1",
+    lifecycleAction: "released",
+    amount: "2500000",
+    contractId: "contract-1",
+    ledgerSeq: "100",
+  });
+});
+
+test("decodeEscrowEvidence silently skips a kind it does not recognize, mirroring chain/events.ts's decodeEvent", () => {
+  const decoded = decodeEscrowEvidence("booking-1", "contract-1", fakeRawEvent({ kind: "some-future-kind-not-yet-known" }));
+  assert.equal(decoded, undefined);
+});
+
+test("decodeEscrowEvidence falls back to \"0\" when the payload carries no recognizable amount, never inventing a value", () => {
+  const decoded = decodeEscrowEvidence("booking-1", "contract-1", fakeRawEvent({ payload: {} }));
+  assert.equal(decoded?.amount, "0");
+});
