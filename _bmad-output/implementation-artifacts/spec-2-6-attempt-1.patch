index 0000000..22e045b
--- /dev/null
+++ b/backend/src/db/escrowReconcilerCursor.ts
@@ -0,0 +1,37 @@
+/**
+ * The Trustless Work reconciler's own stored cursor (Story 2.6, retargeting
+ * AD-9 from `chain/event-worker.ts`): a single row (`id = 1`) in
+ * `escrow_reconciler_state` -- a table separate from `event_worker_state`,
+ * so this reconciler's restart/replay behavior can never be coupled to the
+ * (now-dead-code) Soroban worker's own cursor. `../escrow/trustless-work/
+ * reconciler.ts` reads it before each run and writes it back after, so a
+ * restart resumes after the cursor instead of at the beginning.
+ */
+import { eq } from "drizzle-orm";
+
+import type { Db } from "./client.js";
+import { escrowReconcilerState } from "./schema.js";
+
+const SINGLETON_ID = 1;
+
+/** `undefined` before the reconciler has ever run (no row yet) or when the
+ * one row's `cursor` is `null` (it ran but has not advanced past the start
+ * -- the same "begin from the top" case as never having run). */
+export async function getEscrowReconcilerCursor(db: Db): Promise<string | undefined> {
+  const rows = await db
+    .select()
+    .from(escrowReconcilerState)
+    .where(eq(escrowReconcilerState.id, SINGLETON_ID))
+    .limit(1);
+  return rows[0]?.cursor ?? undefined;
+}
+
+export async function setEscrowReconcilerCursor(db: Db, cursor: string, now: number = Date.now()): Promise<void> {
+  await db
+    .insert(escrowReconcilerState)
+    .values({ id: SINGLETON_ID, cursor, updatedAt: now })
+    .onConflictDoUpdate({
+      target: escrowReconcilerState.id,
+      set: { cursor, updatedAt: now },
+    });
+}
