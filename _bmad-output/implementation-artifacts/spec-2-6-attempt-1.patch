index 0000000..15c5571
--- /dev/null
+++ b/backend/src/escrow/trustless-work/reconciler.ts
@@ -0,0 +1,312 @@
+/**
+ * The cursored, idempotent Trustless Work reconciler (AD-9) -- Story 2.6's
+ * retarget of `chain/event-worker.ts` onto Trustless Work evidence instead
+ * of Soroban `getEvents`. The only writer of `bookings.escrow_state` for
+ * any Trustless-Work-backed booking (AD-1/AD-3); every other module that
+ * touches a booking row leaves that column alone.
+ *
+ * `runReconcilerOnce` is one batch: read the stored cursor
+ * (`db/escrowReconcilerCursor.ts`), fetch evidence since it through the
+ * injected `FetchEscrowEvidence` seam, apply each item at most once
+ * (`escrow_processed_events` dedupes by `(transactionHash,
+ * lifecycleAction)`, not `chain/event-worker.ts`'s `(bookingId,
+ * eventType)` -- a Trustless Work escrow's evidence is keyed by the
+ * transaction that produced it), then advance the cursor -- so a restart
+ * resumes from where it left off rather than from the first page.
+ *
+ * **No global event cursor, unlike Soroban's `getEvents`.** Confirmed
+ * against the installed `@trustless-work/escrow-js@1.0.0-beta.1`'s real
+ * types: `EscrowRestService.listEscrowEvents(contractId, params?)` is
+ * scoped to one escrow's `contractId` at a time -- there is no single
+ * "every event across every escrow since cursor X" endpoint the way
+ * Soroban's `getEvents` was. `realFetchEscrowEvidence` below is this
+ * story's own engineering decision for the *real* implementation (never
+ * exercised by a test, per this story's own hard rule): page
+ * `listEscrows` -- scoped to Pactly's own platform/participant -- ordered
+ * by `updatedAt` ascending, and for every escrow the page returns, fetch
+ * that escrow's own events and flatten them into one evidence batch. An
+ * escrow that receives a new lifecycle event has its `updatedAt` bumped,
+ * so it reappears past whatever cursor was last stored -- which is what
+ * lets a later poll ever see it again.
+ */
+import {
+  TrustlessWorkClient,
+  type EscrowEvent,
+  type ListEscrowEventsParams,
+  type ListEscrowsParams,
+  type ListEscrowsResponse,
+  type ListEscrowEventsResponse,
+} from "@trustless-work/escrow-js";
+
+import { config } from "../../config.js";
+import { getBookingById, updateEscrowStateSync } from "../../db/bookings.js";
+import { getEscrowReconcilerCursor, setEscrowReconcilerCursor } from "../../db/escrowReconcilerCursor.js";
+import { insertEscrowProcessedEventIfNewSync } from "../../db/escrowProcessedEvents.js";
+import type { Db, DbOrTx } from "../../db/client.js";
+import type { EscrowState } from "../../db/schema.js";
+import { EscrowConfigError } from "./errors.js";
+
+/**
+ * The only four lifecycle kinds this story's own I/O matrix names for
+ * "event batch mirrored" -- `funded`, `approved`, `released`, `disputed`.
+ * A dispute's eventual *resolution* (Pactly signing `resolveDispute`,
+ * never an automatic deadline) is not one of them: the real SDK's
+ * `EscrowEvent.kind` carries no fixed enum (it is a bare `string`), and
+ * this story's matrix does not name what a resolved-dispute evidence kind
+ * is called or how its distribution should map onto `escrow_state`'s
+ * three values -- left as a follow-up per this story's own final report,
+ * not guessed at here. Any `kind` outside this list is treated exactly
+ * like `chain/events.ts`'s `decodeEvent` treats an unrecognized topic
+ * name: silently skipped, never processed, never recorded.
+ */
+const RECOGNIZED_LIFECYCLE_ACTIONS = ["funded", "approved", "released", "disputed"] as const;
+export type EscrowLifecycleAction = (typeof RECOGNIZED_LIFECYCLE_ACTIONS)[number];
+
+function isLifecycleAction(value: string): value is EscrowLifecycleAction {
+  return (RECOGNIZED_LIFECYCLE_ACTIONS as readonly string[]).includes(value);
+}
+
+/**
+ * Maps a recognized lifecycle action onto `bookings.escrow_state`'s three
+ * values -- `chain/event-worker.ts`'s `escrowStateForEvent`, retargeted.
+ * `disputed` stays `locked`: opening a dispute never moves money on its
+ * own, and this reconciler never infers a resolution outcome -- Pactly
+ * resolves a dispute explicitly, as Dispute Resolver, via the adapter's
+ * own `resolveDispute` call (Story 1.8 AC7), never automatically here.
+ */
+export function escrowStateForLifecycleAction(action: EscrowLifecycleAction): EscrowState {
+  switch (action) {
+    case "funded":
+      return "locked";
+    case "approved":
+      return "locked";
+    case "released":
+      return "released";
+    case "disputed":
+      return "locked";
+  }
+}
+
+/** One decoded piece of Trustless Work evidence, already stripped of the
+ * SDK's own read-model shape -- `bookingId` is the escrow's own
+ * `engagementId` (AD-13: always Pactly's own booking id, set on deploy),
+ * `amount` as an integer string (AD-7), never the SDK's human-decimal
+ * `number`. */
+export interface EscrowEvidence {
+  bookingId: string;
+  transactionHash: string;
+  lifecycleAction: EscrowLifecycleAction;
+  /** Integer string, smallest unit (AD-7) -- best-effort from the event's
+   * own `payload` (a bare `Record<string, unknown>` in the real SDK, no
+   * fixed schema); `"0"` when the payload carries no recognizable amount
+   * field, since this reconciler never invents a value it cannot read. */
+  amount: string;
+  contractId: string;
+  ledgerSeq: string;
+}
+
+export interface FetchEscrowEvidenceResult {
+  evidence: EscrowEvidence[];
+  /** Always present, even for an empty batch -- mirrors
+   * `chain/events.ts`'s `FetchEventsResult.cursor`. */
+  cursor: string;
+}
+
+/** The reconciler's one seam onto the network: given the last processed
+ * cursor (`undefined` on a first run), returns the next batch and the
+ * cursor to resume from. Defaults to {@link realFetchEscrowEvidence}. */
+export type FetchEscrowEvidence = (cursor: string | undefined) => Promise<FetchEscrowEvidenceResult>;
+
+/** Decodes one raw `EscrowEvent` into {@link EscrowEvidence}, or `undefined`
+ * when its `kind` is not one of {@link RECOGNIZED_LIFECYCLE_ACTIONS} --
+ * exported so it can be unit-tested on its own, with hand-built events,
+ * never a real network round trip (mirrors `chain/events.ts`'s
+ * `decodeEvent`). */
+export function decodeEscrowEvidence(bookingId: string, contractId: string, event: EscrowEvent): EscrowEvidence | undefined {
+  if (!isLifecycleAction(event.kind)) return undefined;
+  const payloadAmount = event.payload?.["amount"];
+  const amount = typeof payloadAmount === "string" && /^\d+$/.test(payloadAmount) ? payloadAmount : "0";
+  return {
+    bookingId,
+    transactionHash: event.txHash,
+    lifecycleAction: event.kind,
+    amount,
+    contractId,
+    ledgerSeq: event.ledgerSeq,
+  };
+}
+
+export interface EscrowEvidenceCallDeps {
+  apiUrl: string;
+  apiKey: string;
+  platformId: string;
+  platformAddress: string;
+  listEscrows: (params: ListEscrowsParams) => Promise<ListEscrowsResponse>;
+  listEscrowEvents: (contractId: string, params?: ListEscrowEventsParams) => Promise<ListEscrowEventsResponse>;
+}
+
+function defaultEvidenceDeps(overrides: Partial<EscrowEvidenceCallDeps>): EscrowEvidenceCallDeps {
+  const apiUrl = overrides.apiUrl ?? config.trustlessWorkApiUrl;
+  const apiKey = overrides.apiKey ?? config.trustlessWorkApiKey;
+  const platformId = overrides.platformId ?? config.trustlessWorkPlatformId;
+  const platformAddress = overrides.platformAddress ?? config.trustlessWorkPlatformAddress;
+
+  let client: TrustlessWorkClient | undefined;
+  const getClient = (): TrustlessWorkClient => {
+    if (!apiUrl) {
+      throw new EscrowConfigError(
+        "TRUSTLESS_WORK_API_URL is empty. Configure the Trustless Work API base URL " +
+          "before starting the escrow reconciler (see .env.example).",
+      );
+    }
+    client ??= new TrustlessWorkClient({ baseURL: apiUrl, apiKey });
+    return client;
+  };
+
+  return {
+    apiUrl,
+    apiKey,
+    platformId,
+    platformAddress,
+    listEscrows: overrides.listEscrows ?? ((params) => getClient().rest.listEscrows(params)),
+    listEscrowEvents: overrides.listEscrowEvents ?? ((contractId, params) => getClient().rest.listEscrowEvents(contractId, params)),
+  };
+}
+
+/** The real implementation -- see this module's own top doc comment for
+ * why its cursor is the escrow list's own keyset cursor, not a single
+ * global event cursor. Never called by this story's own tests. */
+export function realFetchEscrowEvidence(overrides: Partial<EscrowEvidenceCallDeps> = {}): FetchEscrowEvidence {
+  const deps = defaultEvidenceDeps(overrides);
+  return async (cursor) => {
+    const page = await deps.listEscrows({
+      platformId: deps.platformId || undefined,
+      participant: deps.platformAddress || undefined,
+      sort: "updatedAt",
+      order: "asc",
+      cursor,
+    });
+
+    const evidence: EscrowEvidence[] = [];
+    for (const row of page.data) {
+      if (!row.engagementId) continue;
+      const events = await deps.listEscrowEvents(row.contractId);
+      for (const event of events.data) {
+        const decoded = decodeEscrowEvidence(row.engagementId, row.contractId, event);
+        if (decoded) evidence.push(decoded);
+      }
+    }
+
+    // `nextCursor` is `null` once the escrow list has no further page; in
+    // that case there is nothing further to advance to yet, so resume from
+    // the same cursor next run (an escrow whose `updatedAt` changes will
+    // reappear past it) rather than losing the caller's place.
+    return { evidence, cursor: page.nextCursor ?? cursor ?? "" };
+  };
+}
+
+export type ProcessEvidenceOutcome = "applied" | "duplicate" | "anomaly";
+
+export interface ProcessEvidenceDeps {
+  /** Overridable only so a test can simulate a failure between the dedupe
+   * insert and the escrow-state write (mirrors `chain/event-worker.ts`'s
+   * own `ProcessEventDeps`); the real writer is always
+   * {@link updateEscrowStateSync}. */
+  updateEscrowState?: (tx: DbOrTx, bookingId: string, escrowState: EscrowState) => void;
+}
+
+/** Applies one piece of evidence, at most once. Returns which of the
+ * three I/O-matrix outcomes happened.
+ *
+ * The dedupe insert and the escrow-state write commit together, in one
+ * `db.transaction()` -- the same atomicity `chain/event-worker.ts`'s
+ * `processEvent` established, retargeted onto `escrow_processed_events`:
+ * if the write throws, better-sqlite3 rolls the whole transaction back, so
+ * no dedupe row is ever left behind without its escrow-state write having
+ * happened. */
+export async function processEscrowEvidence(
+  db: Db,
+  evidence: EscrowEvidence,
+  log: (message: string) => void = defaultLog,
+  deps: ProcessEvidenceDeps = {},
+): Promise<ProcessEvidenceOutcome> {
+  const updateEscrowState = deps.updateEscrowState ?? updateEscrowStateSync;
+  const booking = await getBookingById(db, evidence.bookingId);
+
+  // Synchronous throughout, per better-sqlite3's transaction contract: an
+  // `await` inside this callback would let the driver COMMIT before the
+  // awaited write actually ran.
+  const isNew = db.transaction((tx) => {
+    const inserted = insertEscrowProcessedEventIfNewSync(tx, {
+      bookingId: evidence.bookingId,
+      transactionHash: evidence.transactionHash,
+      lifecycleAction: evidence.lifecycleAction,
+      amount: evidence.amount,
+      contractId: evidence.contractId,
+      ledgerSeq: evidence.ledgerSeq,
+      isAnomaly: booking === undefined,
+      processedAt: Date.now(),
+    });
+    if (inserted && booking) {
+      updateEscrowState(tx, evidence.bookingId, escrowStateForLifecycleAction(evidence.lifecycleAction));
+    }
+    return inserted;
+  });
+
+  if (!isNew) {
+    // Replay of an already-processed (transactionHash, lifecycleAction)
+    // pair: nothing changes, including the booking row untouched below.
+    return "duplicate";
+  }
+  if (!booking) {
+    // Recorded above (so a later reconciliation can find it), but no
+    // booking row is invented -- the I/O matrix's "evidence for unknown
+    // booking" row.
+    log(
+      `[escrow-reconciler] anomaly: "${evidence.lifecycleAction}" evidence (tx ${evidence.transactionHash}) ` +
+        `for unknown booking ${evidence.bookingId} (contract ${evidence.contractId})`,
+    );
+    return "anomaly";
+  }
+  return "applied";
+}
+
+function defaultLog(message: string): void {
+  console.error(message);
+}
+
+export interface ReconcilerDeps {
+  db: Db;
+  fetchEscrowEvidence: FetchEscrowEvidence;
+  log?: (message: string) => void;
+}
+
+export interface RunReconcilerResult {
+  applied: number;
+  duplicates: number;
+  anomalies: number;
+  cursor: string;
+}
+
+/** Runs exactly one fetch-and-apply batch. A long-running process calls
+ * this in a loop (not this story's job, mirroring `chain/event-worker.ts`'s
+ * own note); a test calls it directly, once or several times, against a
+ * real temporary database. */
+export async function runReconcilerOnce(deps: ReconcilerDeps): Promise<RunReconcilerResult> {
+  const { db, fetchEscrowEvidence, log = defaultLog } = deps;
+  const cursor = await getEscrowReconcilerCursor(db);
+  const { evidence, cursor: nextCursor } = await fetchEscrowEvidence(cursor);
+
+  let applied = 0;
+  let duplicates = 0;
+  let anomalies = 0;
+  for (const item of evidence) {
+    const outcome = await processEscrowEvidence(db, item, log);
+    if (outcome === "applied") applied += 1;
+    else if (outcome === "duplicate") duplicates += 1;
+    else anomalies += 1;
+  }
+
+  await setEscrowReconcilerCursor(db, nextCursor);
+  return { applied, duplicates, anomalies, cursor: nextCursor };
+}
diff --git a/backend/test/escrow-trustless-work-client.test.ts b/backend/test/escrow-trustless-work-client.test.ts
